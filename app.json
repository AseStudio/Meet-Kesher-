{
  "expo": {
    "name": "Kesher",
    "slug": "Kesher",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "scheme": "kesher",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.studioase.kesher"
    },
    "android": {
      "package": "com.studioase.kesher",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#E6F4FE"
      }
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ea4cfc78-340e-4ab7-8d24-696676708d1e"
      }
    },
    "owner": "ase26"
  }
}